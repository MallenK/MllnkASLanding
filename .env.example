# Copia este archivo a .env.local para desarrollo, y añade las mismas
# variables en Vercel (Project Settings -> Environment Variables) para
# producción. Ninguna de las dos es obligatoria para que "npm run dev"
# funcione, pero SIN NEXT_PUBLIC_WEB3FORMS_KEY el formulario de contacto y
# el gate de email antes de la demo no podrán enviar nada.

# Gratis en https://web3forms.com — crea una cuenta, copia tu "Access Key".
# La usan tanto el formulario de contacto como el gate de email de la demo.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Opcional. Gratis en Google Search Console: crea la propiedad, verifica con
# el método "etiqueta HTML" y pega aquí solo el valor del atributo content.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Opcional. C�digo de Bing Webmaster Tools (etiqueta meta msvalidate.01).
# Si no se define, se usa el valor por defecto de src/app/layout.tsx.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
